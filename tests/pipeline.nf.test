// Whole-pipeline stub test. Runs the DAG with -stub-run (no containers, no real tools).
//   nf-test test                 # all tests
//   nf-test test --tag stub      # just this one
//
// DAG: DORADO_BASECALLER -> DORADO_ALIGNER -> SAMTOOLS_SORT -> SAMTOOLS_INDEX
//      -> { SAMTOOLS_STATS -> MULTIQC, MODKIT_PILEUP }
// Path asserts below check the published stub outputs; add more as steps get wired
// (see the add-test skill).
nextflow_pipeline {

    name   "pipeline"
    script "../main.nf"
    tag    "stub"

    test("stub run completes") {

        options "-stub-run"

        when {
            params {
                input     = "$projectDir/tests/data/samplesheet.csv"
                reference = "$projectDir/tests/data/reference.fa"
                outdir    = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 13 },     // 2 samples x 6 steps + MULTIQC
                { assert path("$outputDir/dorado_basecaller/sample1.bam").exists() },
                { assert path("$outputDir/alignments/sample1.sorted.bam").exists() },
                { assert path("$outputDir/alignments/sample1.sorted.bam.bai").exists() },
                { assert path("$outputDir/modkit_pileup/sample2.bedmethyl").exists() },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert path("$outputDir/pipeline_info/software_versions.yml").exists() }
            )
        }
    }
}
