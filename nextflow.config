/*
 * Pipeline config. Layering:
 *   params (here)  ->  conf/base.config (resources per label)  ->  conf/modules.config
 *   (per-process ext.args / publishDir / container)  ->  profiles (where it runs).
 *
 * All parameters live HERE (no nf-schema). Add a comment per param; that is the docs.
 */

params {
    // --- Input / output ---
    input  = null                  // samplesheet CSV: sample,pod5_dir,condition  (--input)
    outdir = 'results'             // where publishDir writes

    // --- References (point at central HPC paths) ---
    reference = null               // FASTA to align to: transcriptome or genome; used by
                                   // dorado aligner and modkit --ref  (--reference)

    // --- Basecalling ---
    dorado_model = 'sup,m6A,pseU'  // dorado "model complex": simplex model ('sup'/'hac' auto-picks
                                   // by pod5 chemistry, or e.g. 'rna004_130bps_sup@v5.2.0') followed
                                   // by comma-joined modification models. `dorado download --list`
                                   // shows what your dorado version offers.  (--dorado_model)

    // --- Tool switches / thresholds ---
    // min_mapq = 20
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // Local laptop / workstation
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Cluster: slurm + singularity + queues (conf/hpc.config). Or pass your own with -c.
    hpc  { includeConfig 'conf/hpc.config' }
    // Tiny built-in samplesheet; pair with -stub-run for a DAG smoke test,
    // or -profile test,docker / -profile test,hpc for a real tiny run.
    test { includeConfig 'conf/test.config' }
}

manifest {
    name            = 'nf-drs-mod'
    description     = 'Direct RNA-seq base modification pipeline'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'              // resourceLimits requires 24.04+
}
