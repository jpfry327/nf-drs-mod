/*
 * Test profile: tiny built-in samplesheet under tests/data/.
 *   nextflow run . -profile test -stub-run        # DAG smoke test, no containers needed
 *   nextflow run . -profile test,docker           # real tiny run on a laptop
 *   nextflow run . -profile test,hpc              # real tiny run on the cluster
 * No container engine is enabled here on purpose: stub runs need none.
 */
params {
    input     = "${projectDir}/tests/data/samplesheet.csv"
    outdir    = 'results-test'
    reference = "${projectDir}/tests/data/reference.fa"      // empty placeholder: stub runs only
}

process {
    // Local executor refuses tasks that ask for more than the machine has;
    // cap so process_high (12 cpus) still runs on a laptop / inside docker.
    resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
}
