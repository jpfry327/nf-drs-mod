/*
 * Per-process settings. THE place to change tool behaviour for this pipeline:
 * ext.args (flags), ext.prefix (output basename), publishDir, container.
 * Add a withName block for each module you install or write.
 */
process {

    // Default: results/<process_name_lowercase>/, versions.yml not published
    publishDir = [
        path   : { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode   : 'copy',
        saveAs : { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: 'DORADO_BASECALLER' {
        ext.args = ''            // e.g. '--recursive --estimate-poly-a --models-directory /projects/b1042/dorado_models'
    }

    withName: 'DORADO_ALIGNER' {
        ext.args   = ''          // minimap2 options go through dorado: e.g. '--mm2-opts "-k 14"'
        ext.prefix = { "${meta.id}.aligned" }
        publishDir = [ enabled: false ]                  // unsorted intermediate; sorted BAM published below
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path   : { "${params.outdir}/alignments" },
            mode   : 'copy',
            saveAs : { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path   : { "${params.outdir}/alignments" },
            mode   : 'copy',
            saveAs : { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        ext.args = ''
    }

    withName: 'MODKIT_PILEUP' {
        ext.args = ''            // e.g. '--filter-threshold 0.8' or '--motif DRACH 2'
    }

    withName: 'MULTIQC' {
        ext.args = ''                                    // e.g. '--title "My run"'
    }

    // ---------------------------------------------------------------------
    // Examples for modules you add (uncomment and adapt)
    // ---------------------------------------------------------------------
    // withName: 'FASTP' {
    //     ext.args   = '--detect_adapter_for_pe'
    //     ext.prefix = { "${meta.id}.trimmed" }          // default in modules is meta.id
    // }
    //
    // Container override: custom build on the cluster, or a different pinned image.
    // withName: 'STAR_ALIGN' {
    //     container = '/projects/b1042/containers/star_2.7.11b.sif'
    // }
    //
    // Publish somewhere else, or not at all:
    // withName: 'SAMTOOLS_INDEX' {
    //     publishDir = [ path: { "${params.outdir}/alignments" }, mode: 'copy' ]
    // }
    // withName: 'SAMTOOLS_SORT' {
    //     publishDir = [ enabled: false ]
    // }
}
